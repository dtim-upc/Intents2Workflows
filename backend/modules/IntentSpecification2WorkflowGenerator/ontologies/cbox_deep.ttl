    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasColumns> ?depVal_2 .
    
}
INSERT {

    ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#TabularDataset> .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#numberOfColumns> cb:Undefined .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasColumns> cb:Undefined .
    
}
WHERE {

    
    ?subject a dmop:TabularDataset .
    OPTIONAL { ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?insVal_1 . }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#numberOfColumns> ?depVal_1 . }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasColumns> ?depVal_2 . }
    
}""" ;
