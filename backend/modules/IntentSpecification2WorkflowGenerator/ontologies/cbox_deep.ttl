cb:implementation-1466884718601038883_polynomialcountsketch_aggregation a tb:AbstractImplementation ;
    rdfs:label "1466884718601038883_PolynomialCountSketch Aggregation" ;
    tb:hasSpecificImplementation cb:implementation-polynomialcountsketch,
        cb:implementation-polynomialfeatures,
        cb:implementation-rbfsampler ;
    tb:has_transformation """DELETE {

    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasDataPrimitiveTypeColumn> ?insVal_1 .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#containsNulls> ?insVal_2 .
    
}
INSERT {

    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasDataPrimitiveTypeColumn> <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#Numeric> .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#containsNulls> false.
    
}
WHERE {

    ?base a dmop:TabularDataset .
    ?base dmop:hasColumn ?subject .
    VALUES ?subject { $$COLUMNS_TO_TRANSFORM$$ }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasDataPrimitiveTypeColumn> ?insVal_1 . }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#containsNulls> ?insVal_2 . }
