    rdfs:label "LatentDirichletAllocation" ;
    tb:has_transformation """DELETE {

    
}
INSERT {

    
}
WHERE {

    ?base a dmop:TabularDataset .
    ?base dmop:hasColumn ?subject .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#isLabel> true.
    
}""",
        """DELETE {

    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#minValue> ?insVal_1 .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#containsNulls> ?insVal_2 .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasDataPrimitiveTypeColumn> ?insVal_3 .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#maxValue> ?insVal_4 .
    
}
INSERT {

    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#minValue> 0.
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#containsNulls> false.
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasDataPrimitiveTypeColumn> <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#Numeric> .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#maxValue> 1.
    
}
WHERE {

    ?base a dmop:TabularDataset .
    ?base dmop:hasColumn ?subject .
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#minValue> ?insVal_1 . }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#containsNulls> ?insVal_2 . }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasDataPrimitiveTypeColumn> ?insVal_3 . }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#maxValue> ?insVal_4 . }
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#isFeature> true.
    
}""",
        """DELETE {

    ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?insVal_1 .
    
}
INSERT {

    ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#TabularDataset> .
    
}
WHERE {

    
    ?subject a dmop:TabularDataset .
    OPTIONAL { ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?insVal_1 . }
    
}""" ;
