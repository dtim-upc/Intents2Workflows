@prefix cb: <https://extremexp.eu/ontology/cbox#> .
@prefix dmop: <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tb: <https://extremexp.eu/ontology/tbox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cb: a owl:Ontology ;
    rdfs:label "ExtremeXP Ontology CBox" .

cb:COPY a tb:Operation .

cb:ClassificationModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:ClassificationModel .

cb:ClusteringModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:ClusteringModel .

cb:DIV a tb:Operation .

cb:DimensionalityReductionModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:DimensionalityReductionModel .

cb:EQ a tb:Operation .

cb:FeatureSelectionModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:FeatureSelectionModel .

cb:FeatureSelectorModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:FeatureSelectorModel .

cb:ImputerModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:ImputerModel .

cb:KNIME a tb:Engine .

cb:MUL a tb:Operation .

cb:NEQ a tb:Operation .

cb:POW a tb:Operation .

cb:Python a tb:Engine .

cb:RegressionModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:RegressionModel .

cb:SQRT a tb:Operation .

cb:SUB a tb:Operation .

cb:SUM a tb:Operation .

cb:TransformationModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:TransformationModel .

cb:TransformerModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:TransformerModel .

cb:VectorizerModel a sh:NodeShape,
        tb:ModelTag ;
    sh:targetClass dmop:VectorizerModel .

cb:component-data_partition_component a tb:Component ;
    rdfs:label "Data partition component" ;
    tb:hasImplementation cb:implementation-data_partition .

cb:component-nonstandard_column_remover_component a tb:Component ;
    rdfs:label "Nonstandard column remover component" ;
    tb:hasImplementation cb:implementation-nonstandard_column_remover .

cb:isGaussianDistributed a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:path dmop:isGaussian .

cb:isStringDatatypePropertyShape a sh:PropertyShape ;
    sh:hasValue dmop:String ;
    sh:path dmop:hasDataPrimitiveTypeColumn .

cb:StandardizedPropertyShape a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:path dmop:isStandardized .

cb:cleaning a tb:Algorithm ;
    rdfs:label "cleaning" ;
    tb:solves cb:DataTransformation .

