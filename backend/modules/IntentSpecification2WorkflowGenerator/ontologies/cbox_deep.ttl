cb:isArrayShapeFeatureShape a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:or ( [ sh:property [ a sh:PropertyShape ;
                                sh:hasValue false ;
                                sh:path dmop:isFeature ] ] [ sh:property cb:isArrayShape ] ) ;
            sh:path dmop:hasColumn ] ;
    sh:targetClass dmop:TabularDataset .

cb:isDictShape a sh:PropertyShape ;
    sh:hasValue dmop:Dict ;
    sh:path rdf:type .

cb:isScaledPropertyShape a sh:PropertyShape ;
    sh:hasValue true ;
    sh:path dmop:isScaled .

cb:isTabularDatasetShape a sh:PropertyShape ;
    sh:hasValue dmop:TabularDataset ;
    sh:path rdf:type .

cb:isTextDocumentShape a sh:PropertyShape ;
    sh:hasValue dmop:TextDocument ;
    sh:path rdf:type .

cb:isTextDocumentShapeDatasetShape a sh:NodeShape ;
    sh:property cb:isTextDocumentShape ;
    sh:targetClass dmop:TabularDataset .

cb:maxOnePropertyShape a sh:PropertyShape ;
    sh:maxInclusive 1 ;
    sh:path dmop:maxValue .

cb:minOneComponentPropertyShape a sh:PropertyShape ;
    sh:minInclusive 1 ;
    sh:path dmop:numberOfColumns .

cb:minTwoClustersPropertyShape a sh:PropertyShape ;
    sh:minInclusive 2 ;
    sh:path dmop:numberOfDistinctValues .

