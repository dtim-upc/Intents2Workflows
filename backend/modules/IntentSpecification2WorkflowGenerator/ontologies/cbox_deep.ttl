cb:StandardizedPropertyShape a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:path dmop:isStandardized .

cb:StandardizedPropertyShapeFeatureShape a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:or ( [ sh:property [ a sh:PropertyShape ;
                                sh:hasValue false ;
                                sh:path dmop:isFeature ] ] [ sh:property cb:StandardizedPropertyShape ] ) ;
            sh:path dmop:hasColumn ] ;
    sh:targetClass dmop:TabularDataset .

