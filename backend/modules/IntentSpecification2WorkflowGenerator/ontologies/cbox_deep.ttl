}""",
        """DELETE {

    ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?insVal_1 .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#numberOfColumns> ?depVal_1 .
    
}
INSERT {

    ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#TabularDataset> .
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#numberOfColumns> cb:Undefined .
    
}
WHERE {

    
    ?subject a dmop:TabularDataset .
    OPTIONAL { ?subject <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?insVal_1 . }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#numberOfColumns> ?depVal_1 . }
    


}""" ;
    tb:implements cb:AbstractAlgorithm ;
    tb:specifiesInput cb:implementation-1466884718601038883_polynomialcountsketch_aggregation-InputSpec-5583473790686700456 ;
    tb:specifiesOutput cb:implementation-1466884718601038883_polynomialcountsketch_aggregation-OutputSpec--856280962211090139,
