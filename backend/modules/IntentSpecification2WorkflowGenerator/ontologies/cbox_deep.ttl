        cb:isTabularDatasetShapeDatasetShape .

cb:RegressionModelModelShape a sh:NodeShape,
        tb:ModelTag ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue tb:ModelTag ;
            sh:path rdf:type ] ;
    sh:targetClass dmop:RegressionModel .

cb:isArrayShapeDatasetShape a sh:NodeShape ;
    sh:property cb:isArrayShape ;
    sh:targetClass dmop:TabularDataset ;
    tb:guaranteesShape cb:isTabularDatasetShapeDatasetShape .

cb:isScaledPropertyShapeFeatureShape a sh:NodeShape ;
    sh:or ( [ sh:property [ a sh:PropertyShape ;
                        sh:hasValue false ;
                        sh:path dmop:isFeature ] ] [ sh:property cb:isScaledPropertyShape ] ) ;
    sh:targetClass dmop:Column ;
    tb:guaranteesShape cb:isArrayShapeDatasetShape,
        cb:isTabularDatasetShapeDatasetShape .

cb:minOneComponentPropertyShapeDatasetShape a sh:NodeShape ;
    sh:property cb:minOneComponentPropertyShape ;
    sh:targetClass dmop:TabularDataset ;
    tb:guaranteesShape cb:isArrayShapeDatasetShape,
        cb:isTabularDatasetShapeDatasetShape .

cb:noMissingValuesPropertyShapeLabelShape a sh:NodeShape ;
    sh:or ( [ sh:property [ a sh:PropertyShape ;
                        sh:hasValue false ;
                        sh:path dmop:isLabel ] ] [ sh:property cb:noMissingValuesPropertyShape ] ) ;
    sh:targetClass dmop:Column ;
    tb:guaranteesShape cb:isArrayShapeDatasetShape,
        cb:isTabularDatasetShapeDatasetShape .

cb:isNumericDatatypePropertyShapeFeatureShape a sh:NodeShape ;
    sh:or ( [ sh:property [ a sh:PropertyShape ;
                        sh:hasValue false ;
                        sh:path dmop:isFeature ] ] [ sh:property cb:isNumericDatatypePropertyShape ] ) ;
    sh:targetClass dmop:Column ;
    tb:guaranteesShape cb:isArrayShapeDatasetShape,
        cb:isCategoricalOrNumericPropertyShapeFeatureShape,
        cb:isContinuousPropertyShapeFeatureShape,
        cb:isTabularDatasetShapeDatasetShape .

cb:noMissingValuesPropertyShapeFeatureShape a sh:NodeShape ;
    sh:or ( [ sh:property [ a sh:PropertyShape ;
                        sh:hasValue false ;
                        sh:path dmop:isFeature ] ] [ sh:property cb:noMissingValuesPropertyShape ] ) ;
    sh:targetClass dmop:Column ;
    tb:guaranteesShape cb:isArrayShapeDatasetShape,
        cb:isTabularDatasetShapeDatasetShape .

cb:isTabularDatasetShapeDatasetShape a sh:NodeShape ;
    sh:property cb:isTabularDatasetShape ;
    sh:targetClass dmop:TabularDataset ;
    tb:guaranteesShape cb:isArrayShapeDatasetShape .

cb:Python a tb:Engine .

