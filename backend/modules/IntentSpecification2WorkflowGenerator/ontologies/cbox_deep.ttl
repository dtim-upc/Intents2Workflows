cb:minZeroPropertyShapeLabelShape a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:or ( [ sh:property [ a sh:PropertyShape ;
                                sh:hasValue false ;
                                sh:path dmop:isLabel ] ] [ sh:property cb:minZeroPropertyShape ] ) ;
            sh:path dmop:hasColumn ] ;
    sh:targetClass dmop:TabularDataset ;
    cb:guaranteesShape cb:isArrayShapeDatasetShape,
        cb:isTabularDatasetShapeDatasetShape .

cb:noMissingValuesPropertyShape a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:path dmop:containsNulls .

cb:exactlyOneColumnPropertyShapeLabelShape a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:or ( [ sh:property [ a sh:PropertyShape ;
                                sh:hasValue false ;
                                sh:path dmop:isLabel ] ] [ sh:property cb:exactlyOneColumnPropertyShape ] ) ;
            sh:path dmop:hasColumn ] ;
    sh:targetClass dmop:TabularDataset .

