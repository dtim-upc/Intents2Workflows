cb:isArrayShape a sh:PropertyShape ;
    sh:or ( [ sh:hasValue dmop:TabularDataset ] ) ;
    sh:path rdf:type .

cb:isArrayShapeFeatureShape a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:or ( [ sh:property [ a sh:PropertyShape ;
                                sh:hasValue false ;
                                sh:path dmop:isFeature ] ] [ sh:property cb:isArrayShape ] ) ;
            sh:path dmop:hasColumn ] ;
    sh:targetClass dmop:TabularDataset .

cb:isBinaryDatatypePropertyShape a sh:PropertyShape ;
    sh:hasValue dmop:Binary ;
    sh:path dmop:hasDataPrimitiveTypeColumn .

cb:isCategoricalOrNumericPropertyShape a sh:PropertyShape ;
    sh:in ( dmop:Float dmop:Integer dmop:Categorical dmop:Binary dmop:CategoricalOrNumeric dmop:Numeric ) ;
    sh:minCount 1 ;
    sh:path dmop:hasDataPrimitiveTypeColumn .

cb:isCategoricalPropertyShape a sh:PropertyShape ;
    sh:hasValue dmop:Categorical ;
    sh:path dmop:hasDataPrimitiveTypeColumn .

cb:isContinuousPropertyShape a sh:PropertyShape ;
    sh:in ( dmop:Float dmop:Integer dmop:Binary dmop:Numeric ) ;
    sh:minCount 1 ;
    sh:path dmop:hasDataPrimitiveTypeColumn .

cb:isIntegerDatatypePropertyShape a sh:PropertyShape ;
    sh:hasValue dmop:Integer ;
    sh:path dmop:hasDataPrimitiveTypeColumn .

cb:isNumericDatatypePropertyShape a sh:PropertyShape ;
    sh:in ( dmop:Float dmop:Integer dmop:Binary dmop:Numeric ) ;
    sh:minCount 1 ;
    sh:path dmop:hasDataPrimitiveTypeColumn .

cb:isTestDatasetShapeDatasetShape a sh:NodeShape ;
    sh:property cb:isTestDatasetShape ;
    sh:targetClass dmop:TabularDataset .

cb:isTextDocumentShapeDatasetShape a sh:NodeShape ;
    sh:property cb:isTextDocumentShape ;
    sh:targetClass dmop:TabularDataset .

cb:isTrainDatasetShapeDatasetShape a sh:NodeShape ;
    sh:property cb:isTrainDatasetShape ;
    sh:targetClass dmop:TabularDataset .

cb:minZeroPropertyShape a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:minInclusive 0 ;
    sh:path dmop:minValue .

cb:DimensionalityReductionModelModelShape a sh:NodeShape,
        tb:ModelTag ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue tb:ModelTag ;
            sh:path rdf:type ] ;
    sh:targetClass dmop:DimensionalityReductionModel .

cb:TransformationModelModelShape a sh:NodeShape,
        tb:ModelTag ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue tb:ModelTag ;
            sh:path rdf:type ] ;
    sh:targetClass dmop:TransformationModel .

