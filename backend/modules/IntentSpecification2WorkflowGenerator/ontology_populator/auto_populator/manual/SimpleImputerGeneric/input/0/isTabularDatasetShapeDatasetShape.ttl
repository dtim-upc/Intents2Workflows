cb:isTabularDatasetShapeDatasetShape
    a sh:NodeShape ;
    sh:targetClass dmop:TabularDataset ;

    
    tb:guaranteesShape cb:isArrayShapeDatasetShape;
    
    
    sh:property cb:isTabularDatasetShape.
