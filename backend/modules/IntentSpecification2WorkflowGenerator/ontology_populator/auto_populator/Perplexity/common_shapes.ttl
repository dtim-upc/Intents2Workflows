
@prefix cb: <https://extremexp.eu/ontology/cbox#> .
@prefix dmop: <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tb: <https://extremexp.eu/ontology/tbox#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#############################
# Boolean Property Shapes
#############################

cb:noMissingValuesPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:containsNulls ;
    sh:hasValue false ;
    sh:datatype xsd:boolean .

cb:isGaussianDistributed
    a sh:PropertyShape ;
    sh:path dmop:isGaussian ;
    sh:hasValue true ;
    sh:datatype xsd:boolean .

#############################
# Datatype Property Shape
#############################

cb:isNumericDatatypePropertyShape
    a sh:PropertyShape ;
    sh:path dmop:hasDataPrimitiveTypeColumn ;
    sh:minCount 1 ;
    sh:in ( dmop:Float dmop:Integer dmop:Binary dmop:Numeric) .

cb:isIntegerDatatypePropertyShape
    a sh:PropertyShape ;
    sh:path dmop:hasDataPrimitiveTypeColumn ;
    sh:hasValue dmop:Integer .

cb:isBinaryDatatypePropertyShape
    a sh:PropertyShape ;
    sh:path dmop:hasDataPrimitiveTypeColumn ;
    sh:hasValue dmop:Binary .

cb:isStringDatatypePropertyShape
    a sh:PropertyShape ;
    sh:path dmop:hasDataPrimitiveTypeColumn ;
    sh:hasValue dmop:String .

cb:isCategoricalOrNumericPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:hasDataPrimitiveTypeColumn ;
    sh:minCount 1 ;
    sh:in ( dmop:Float dmop:Integer dmop:Categorical dmop:Binary dmop:CategoricalOrNumeric dmop:Numeric) .

cb:isCategoricalPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:hasDataPrimitiveTypeColumn ;
    sh:hasValue dmop:Categorical .

cb:isContinuousPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:hasDataPrimitiveTypeColumn ;
    sh:minCount 1 ;
    sh:in ( dmop:Float dmop:Integer dmop:Binary dmop:Numeric) .

#############################
# Non-Boolean Property Shapes
#############################

cb:minZeroPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:minValue ;
    sh:minCount 1 ;
    sh:minInclusive 0 .

cb:maxOnePropertyShape
    a sh:PropertyShape ;
    sh:path dmop:maxValue ;
    sh:minCount 1 ;
    sh:maxInclusive 1 .

cb:minTwoClustersPropertyShape
    a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path dmop:numberOfDistinctValues ;
    sh:minInclusive 2 .

cb:isScaledPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:isScaled ;
    sh:hasValue true .


cb:StandardizedPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:isStandardized ;
    sh:hasValue true ;
    sh:datatype xsd:boolean .

### Dataset shape properties

cb:minOneComponentPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:numberOfColumns ;
    sh:minCount 1 ;
    sh:minInclusive 1 .

cb:exactlyOneColumnPropertyShape
    a sh:PropertyShape ;
    sh:path dmop:numberOfColumns ;
    sh:minCount 1 ;
    sh:minInclusive 1 ;
    sh:maxInclusive 1 .

cb:isTabularDatasetShape
    a sh:PropertyShape ;
    sh:path rdf:type;
    sh:hasValue dmop:TabularDataset .

cb:isDictShape
    a sh:PropertyShape ;
    sh:path rdf:type;
    sh:hasValue dmop:Dict .

cb:isArrayShape a sh:PropertyShape ;
    sh:or (
        #[ sh:hasValue dmop:Array ] TODO fix array inconsistences
        [ sh:hasValue dmop:TabularDataset ]
    ) ;
    sh:path rdf:type .


cb:isTextDocumentShape
    a sh:PropertyShape ;
    sh:path rdf:type;
    sh:hasValue dmop:TextDocument .

cb:hasReducedDimensionality
    sh:path dmop:dimension;
    sh:minCount 1 ;
    a sh:PropertyShape .

cb:hasIncreasedDimensionality
    sh:path dmop:dimension;
    sh:minCount 1 ;
    a sh:PropertyShape .

cb:isTestDatasetShape a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:path dmop:isTestDataset .

cb:isTrainDatasetShape a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:path dmop:isTrainDataset .